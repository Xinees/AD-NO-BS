    <category id="obsidiceratops">
        <page src="infos/1">
            <container popup="popups/1" hover-animation="scale" x="63" y="63" w="104" h="80">
                <image src="images/1" absolute="true" w="576" h="320"/>
            </container>
            <label hex="#573d19" x="98" y="48">Herbívoro</label>
            <label hex="#573d19" x="189" y="48">Bioma</label>
            <label hex="#947546" x="172" y="105" align="center" w="36" scale="0.42">Valle de almas</label>
