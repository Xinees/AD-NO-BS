                <color hex="#947546">•</color> Dynia<br/>
                <color hex="#947546">•</color> Ciasto<br/>
                <color hex="#947546">•</color> Blok bambusa<br/>
                <color hex="#947546">•</color> Liście azalii<br/>
                <color hex="#947546">•</color> Blok grzyba
            </label>
            <label hex="#573d19" x="60" y="212" w="214">
