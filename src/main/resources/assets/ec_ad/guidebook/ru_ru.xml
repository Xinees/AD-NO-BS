                    </recipe>
                    <recipe item="ec_ad:theri_claw_copper" x="296" y="98">
                        <label x="58" scale="0.65"><b>Медные когти теримоха</b></label>
                    </recipe>
                    <recipe item="ec_ad:theri_claw_gold" x="296" y="169">
                        <label x="58" scale="0.65"><b>Золотые когти теримоха</b></label>
                    </recipe>
                    <recipe item="ec_ad:theri_claw_diamond" x="296" y="238">
                        <label x="58" scale="0.65"><b>Алмазные когти теримоха</b></label>
                    </recipe>
                </popup-content>
            </container>
            <container popup="popups/4" hover-animation="scale" x="337" y="260" w="142" h="43">
                <image src="images/2" src-x="337" src-y="260" texture-width="576" texture-height="320"/>
                <popup-content>
                    <recipe item="ec_ad:therimoss_helmet" x="296" y="27">
                        <label x="58" scale="0.65"><b>Шлем теримоха</b></label>
                    </recipe>
                    <recipe item="ec_ad:therimoss_chestplate" x="296" y="98">
                        <label x="58" scale="0.65"><b>Нагрудник теримоха</b></label>
                    </recipe>
                    <recipe item="ec_ad:therimoss_leggings" x="296" y="169">
                        <label x="58" scale="0.65"><b>Поножи теримоха</b></label>
                    </recipe>
                    <recipe item="ec_ad:therimoss_boots" x="296" y="240">
                        <label x="58" scale="0.65"><b>Ботинки теримоха</b></label>
                    </recipe>
                </popup-content>
            </container>
        </page>
    </category>
    <category id="coralosaur">
        <page src="infos/1">
            <container popup="popups/1" hover-animation="scale" x="63" y="63" w="99" h="99">
                <image src="images/1" absolute="true" w="576" h="320"/>
            </container>
            <label hex="#573d19" x="100" y="56">Хищник</label>
            <label hex="#573d19" x="186" y="62">Биом</label>
            <label hex="#947546" x="199" y="121" align="center" scale="0.7">Тёплый океан</label>
            <label hex="#573d19" x="244" y="62">Дроп</label>
            <label hex="#947546" x="238" y="100" align="center" scale="0.42" w="28">Коралловое ребро</label>
            <label hex="#573d19" x="64" y="186" w="214">
