                    </recipe>
                </popup-content>
            </container>
            <label hex="#573d19" x="305" y="150" w="210">
                Forja a armadura de coralosaur com Costelas de coral.
            </label>
            <container x="315" y="180">
                <label hex="#947546" w="180">→ Bónus de conjunto:</label>
                <label hex="#573d19" x="12" y="10" w="180">Velocidade de nado, pressa e poder do canal sob a água</label>
                <label hex="#947546" y="50" w="180">→ Especial: <color hex="#573d19">Chamado do Mar</color> (4s ⌚)</label>
                <label hex="#573d19" x="12" y="62" w="170">
                    Prime <color hex="#947546"><u><keybind id="ec_ad.armor"/></u></color> na água para invocares guardiões aliados.
                </label>
            </container>
            <container popup="popups/4" hover-animation="scale" x="337" y="260" w="142" h="43">
                <image src="images/2" src-x="337" src-y="260" texture-width="576" texture-height="320"/>
                <popup-content>
                    <recipe item="ec_ad:coralosaur_helmet" x="296" y="27">
                        <label x="58" scale="0.65"><b>Capacete de coralosaur</b></label>
                    </recipe>
                    <recipe item="ec_ad:coralosaur_chestplate" x="296" y="98">
                        <label x="58" scale="0.65"><b>Peitoral de coralosaur</b></label>
                    </recipe>
                    <recipe item="ec_ad:coralosaur_leggings" x="296" y="169">
                        <label x="58" scale="0.65"><b>Perneiras de coralosaur</b></label>
                    </recipe>
                    <recipe item="ec_ad:coralosaur_boots" x="296" y="240">
                        <label x="58" scale="0.65"><b>Botas de coralosaur</b></label>
                    </recipe>
                </popup-content>
            </container>
        </page>
    </category>
    <category id="obsidiceratops">
        <page src="infos/1">
            <container popup="popups/1" hover-animation="scale" x="63" y="63" w="104" h="80">
                <image src="images/1" absolute="true" w="576" h="320"/>
            </container>
            <label hex="#573d19" x="98" y="48">Herbívoro</label>
            <label hex="#573d19" x="189" y="48">Bioma</label>
            <label hex="#947546" x="172" y="105" align="center" w="36" scale="0.42">Vale das almas</label>
