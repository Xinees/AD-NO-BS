                </popup-content>
            </container>
            <label hex="#573d19" x="305" y="150" w="210">
                Die Rüstung wird aus Korallenrippen gefertigt.
            </label>
            <container x="315" y="180">
                <label hex="#947546" w="180">→ Set-Bonus:</label>
                <label hex="#573d19" x="12" y="10" w="180">Schwimmtempo, Eile &amp; Meeresschutz unter Wasser</label>
                <label hex="#947546" y="50" w="180">→ Spezial: <color hex="#573d19">Meeresbefehl</color> (4s ⌚)</label>
                <label hex="#573d19" x="12" y="62" w="170">
                    Drücke <color hex="#947546"><u><keybind id="ec_ad.armor"/></u></color> im Wasser, um Wächter zu rufen.
                </label>
            </container>
            <container popup="popups/4" hover-animation="scale" x="337" y="260" w="142" h="43">
                <image src="images/2" src-x="337" src-y="260" texture-width="576" texture-height="320"/>
                <popup-content>
                    <recipe item="ec_ad:coralosaur_helmet" x="296" y="27">
                        <label x="58" scale="0.65"><b>Coralosaur-Helm</b></label>
                    </recipe>
                    <recipe item="ec_ad:coralosaur_chestplate" x="296" y="98">
                        <label x="58" scale="0.65"><b>Coralosaur-Brustplatte</b></label>
                    </recipe>
                    <recipe item="ec_ad:coralosaur_leggings" x="296" y="169">
                        <label x="58" scale="0.65"><b>Coralosaur-Beinschutz</b></label>
                    </recipe>
                    <recipe item="ec_ad:coralosaur_boots" x="296" y="240">
                        <label x="58" scale="0.65"><b>Coralosaur-Stiefel</b></label>
                    </recipe>
                </popup-content>
            </container>
        </page>
    </category>
    <category id="obsidiceratops">
        <page src="infos/1">
            <container popup="popups/1" hover-animation="scale" x="63" y="63" w="104" h="80">
                <image src="images/1" absolute="true" w="576" h="320"/>
            </container>
            <label hex="#573d19" x="98" y="48">Herbivor</label>
