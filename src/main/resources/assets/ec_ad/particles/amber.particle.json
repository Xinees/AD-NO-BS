{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ec_ad:amber",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "ec_ad:textures/emitter/glow_pixel"
			}
		},
		"curves": {
			"variable.x": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [1, 1.13, 1]
			},
			"variable.r": {
				"type": "linear",
				"input": "variable.particle_random_3",
				"horizontal_range": 1,
				"nodes": [0, 0, 0.12, 0.34, 0.6, 0.79, 1, 1.12, 1.14, 1, 3.26]
			},
			"variable.scale": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0.69, 1, 1, 0.91, 0]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 5,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_box": {
				"half_dimensions": [0.5, 0, 0.5],
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.5, 2)"
			},
			"minecraft:particle_initial_speed": "-1*variable.particle_random_2",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["v.particle_random_1 < 0.25 ? math.cos(variable.particle_age*180)*2 : v.particle_random_1 < 0.5 ? -math.sin(variable.particle_age*180)*2 : v.particle_random_1 < 0.75 ? -math.cos(variable.particle_age*180)*2 : math.sin(variable.particle_age*180)*2", "6*variable.r+4", "v.particle_random_1 < 0.25 ? math.sin(variable.particle_age*180)*2 : v.particle_random_1 < 0.5 ? math.cos(variable.particle_age*180)*2 : v.particle_random_1 < 0.75 ? -math.sin(variable.particle_age*180)*2 : -math.cos(variable.particle_age*180)*2"],
				"linear_drag_coefficient": 6
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.025*variable.x*variable.scale", "0.025*variable.scale"],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [60, 60],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.24": "#FFFF0000",
						"0.44": "#EDFF2D00",
						"0.62": "#ADFF5921",
						"0.74": "#A8FF8700",
						"0.89": "#0FA7A7A7",
						"1.0": "#00333333"
					}
				}
			}
		}
	}
}