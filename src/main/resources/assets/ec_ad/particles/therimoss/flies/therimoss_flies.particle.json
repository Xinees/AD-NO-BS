{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ec_ad:therimoss_flies",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "ec_ad:textures/emitter/flies"
			}
		},
		"curves": {
			"variable.scale": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1.21, 1, 1, 1, 1, 1, 0]
			},
			"variable.rt": {
				"type": "linear",
				"input": "variable.particle_random_2",
				"horizontal_range": 1,
				"nodes": [-15, 15]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 3,
				"max_particles": 60
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 3
			},
			"minecraft:emitter_shape_box": {
				"half_dimensions": [0.5, 0.5, 1],
				"surface_only": true,
				"direction": ["math.random(0.5, -0.5)", "math.random(0.5, -0.5)", "math.random(0.5, -0.5)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(4, 2)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(360, -360)*variable.particle_random_2",
				"rotation_rate": "math.random(100, -100)*5"
			},
			"minecraft:particle_initial_speed": 1,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["variable.particle_random_1 < 0.50 ? math.cos(variable.particle_age*360)*variable.particle_random_4*-15 : math.sin(variable.particle_age*360)*variable.particle_random_4*15", "variable.particle_random_1 < 0.50 ? math.sin(variable.particle_age*360)*variable.particle_random_2*-15 : math.cos(variable.particle_age*360)*variable.particle_random_2*15+1 ", "variable.particle_random_1 < 0.50 ? math.cos(variable.particle_age*360)*variable.particle_random_3*-15 : math.sin(variable.particle_age*360)*variable.particle_random_3*15"],
				"linear_drag_coefficient": 4
			},
			"minecraft:particle_motion_parametric": {
				"rotation": "math.cos(variable.particle_age*360)*5"
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.1, 0.1],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 50,
					"texture_height": 150,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [50, 50],
						"step_UV": [0, 50],
						"frames_per_second": 12,
						"max_frame": 3,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_random_4",
					"gradient": {
						"0.0": "#FF333333",
						"1.0": "#FF4A4A4A"
					}
				}
			},
			"minecraft:emitter_local_space": {
				"position": true
			}
		}
	}
}