{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "ec_ad:totem_on_place",
            "basic_render_parameters": {
                "material": "particles_add",
                "texture": "ec_ad:textures/emitter/light_2_glow"
            }
        },
        "components": {
            "minecraft:emitter_rate_instant": {
                "num_particles": 2
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 1
            },
            "minecraft:emitter_shape_point": {
                "direction": [
                    "math.cos(variable.particle_random_1 * 360)",
                    0,
                    "math.sin(variable.particle_random_1 * 360)"
                ]
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": 1
            },
            "minecraft:particle_initial_speed": 20,
            "minecraft:particle_motion_dynamic": {
                "linear_drag_coefficient": 8
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "0.75 * (1 - v.particle_age)",
                    "math.pow((1 - v.particle_age), 2) * 7"
                ],
                "facing_camera_mode": "rotate_y",
                "uv": {
                    "texture_width": 16,
                    "texture_height": 16,
                    "uv": [0, 0],
                    "uv_size": [16, 16]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "v.particle_age / v.particle_lifetime",
                    "gradient": {
                        "0.0": "#FFFF0000",
                        "1.0": "#FFFF9C00"
                    }
                }
            }
        }
    }
}
